{
    "experiment_id": "EXP-816",
    "experiment_name": "CalibratedGate_BalancedSeg",
    "experiment_root": "experiments",
    "seed": 42,
    "dataset_root": "D:\\00_MRI_Meningioma_Synthesis_Project\\03_dataset_release\\dataset_5fold_final_v4",
    "fold": 3,
    "batch_size": 4,
    "epochs": 200,
    "lr": 0.0001,
    "weight_decay": 0.0,
    "optimizer": "Adam",
    "early_stop_patience": 45,
    "model": "EDMSynth",
    "base_channels": 32,
    "modalities": [
        "T1",
        "T2",
        "FLAIR"
    ],
    "discriminator": {
        "name": "patchgan",
        "in_channels": 10,
        "base_channels": 64,
        "use_spectral_norm": true
    },
    "gan": {
        "use_gan": false,
        "lambda_gan": 0.0,
        "gan_loss": "lsgan",
        "warmup_epochs": 35,
        "d_updates_per_g": 1,
        "g_loss_clip": 0.5
    },
    "scheduler": {
        "use_scheduler": true,
        "type": "cosine",
        "eta_min": 2e-05
    },
    "grad_clip": {
        "use_clip": true,
        "max_norm": 1.0,
        "warmup_norm": 0.5,
        "warmup_epochs": 10
    },
    "optimizer_groups": {
        "use_groups": true,
        "projection_lr": 5e-05,
        "projection_keys": [
            "bridge",
            "skip_proj",
            "enh_head",
            "enh_gate"
        ]
    },
    "loss": "EDMLoss",
    "enhancement": {
        "weak_thr": 0.025,
        "strong_thr": 0.1,
        "very_strong_thr": 0.25,
        "w_weak": 1.0,
        "w_strong": 3.0,
        "w_very_strong": 5.0
    },
    "sharpness": {
        "use_sharpness": true,
        "weight": 0.3,
        "patch_size": 8
    },
    "enh_seg": {
        "use_enh_seg": true,
        "seg_loss_weight": 0.8,
        "gate_weight": 0.35,
        "enh_threshold": 0.025
    },
    "calibration": {
        "use_calibration": true,
        "weight": 0.4
    },
    "amp": true,
    "num_workers": 2,
    "pin_memory": true,
    "nan_guard": {
        "loss_upper_bound": 50.0,
        "max_nan_per_epoch": 10
    }
}